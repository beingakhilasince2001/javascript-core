// # 1️⃣0️⃣ Scope

// Scope = where variable is accessible.

// Three main scopes:

// ```txt
// Global scope
// Function scope
// Block scope
// ```

// ---

// # Global Scope

// Declared outside everything.

// ```js
// let appName = "My App";
// ```

// Accessible everywhere below declaration.

// Too many globals are dangerous because of naming conflicts.

// ---

// # Function Scope

// Variables inside function exist only there.

// ```js
// function greet() {
//   let msg = "Hello";
// }

// console.log(msg); // Error
// ```

// ---

// # `var` Is Function Scoped

// ```js
// function test() {
//   var x = 10;
// }

// console.log(x); // Error
// ```

// But `var` escapes blocks.

// ---

// # Block Scope

// Blocks use `{}`

// Examples:

// ```js
// if () {}
// for () {}
// while () {}
// ```

// `let` and `const` are block scoped.

// ```js
// if (true) {
//   let x = 10;
// }

// console.log(x); // Error
// ```

// ---

// # `var` Ignores Block Scope

// ```js
// if (true) {
//   var x = 10;
// }

// console.log(x); // 10
// ```

// Major source of bugs.

// ---

// # 1️⃣1️⃣ Hoisting

// JavaScript processes declarations before execution.

// ---

// # `var` Hoisting

// ```js
// console.log(x);
// var x = 10;
// ```

// Output:

// ```txt
// undefined
// ```

// Internally similar to:

// ```js
// var x;

// console.log(x);

// x = 10;
// ```

// ---

// # `let` and `const`

// ```js
// console.log(x);

// let x = 10;
// ```

// Error.

// ---

// # Temporal Dead Zone (TDZ)

// Time between entering scope and declaration line.

// ```js
// {
//   console.log(name); // Error

//   let name = "Ali";
// }
// ```

// Prevents accidental early access.

